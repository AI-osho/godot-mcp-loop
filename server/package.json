{
  "name": "godot-mcp-loop",
  "version": "0.9.2",
  "description": "MCP server that lets AI agents safely edit, run, observe and test Godot 4 projects.",
  "license": "MIT",
  "author": "OSHO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-osho/godot-mcp-loop.git",
    "directory": "server"
  },
  "homepage": "https://github.com/AI-osho/godot-mcp-loop#readme",
  "bugs": {
    "url": "https://github.com/AI-osho/godot-mcp-loop/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "godot",
    "godot4",
    "gamedev",
    "ai",
    "testing",
    "playtest",
    "gut",
    "gdunit4",
    "claude-code"
  ],
  "type": "module",
  "bin": {
    "godot-mcp-loop": "dist/index.js"
  },
  "files": [
    "dist",
    "addon",
    "skill",
    "samples"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle-assets.mjs",
    "prepack": "npm run build && node scripts/bundle-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'test/e2e/**'",
    "test:e2e": "vitest run test/e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "mcpName": "io.github.AI-osho/godot-mcp-loop"
}
