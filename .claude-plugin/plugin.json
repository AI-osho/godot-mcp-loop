{
  "name": "godot-mcp-loop",
  "version": "0.12.0",
  "description": "Edit, run, inspect and test Godot 4 projects through MCP.",
  "author": {
    "name": "OSHO",
    "url": "https://github.com/AI-osho"
  },
  "homepage": "https://github.com/AI-osho/godot-mcp-loop",
  "repository": "https://github.com/AI-osho/godot-mcp-loop",
  "license": "MIT",
  "keywords": [
    "godot",
    "godot4",
    "gamedev",
    "mcp",
    "scenario-tests"
  ],
  "skills": [
    "./.claude/skills/godot-mcp-loop"
  ],
  "mcpServers": {
    "godot-loop": {
      "command": "npx",
      "args": [
        "-y",
        "godot-mcp-loop@0.12.0",
        "--project",
        "${user_config.project_path}"
      ]
    }
  },
  "userConfig": {
    "project_path": {
      "type": "string",
      "title": "Godot project",
      "description": "Absolute path of the Godot project this plugin should drive (the folder with project.godot)."
    }
  }
}
